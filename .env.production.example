# Fallback API URL baked into the build (optional if kiosk config.json sets apiBaseUrl).
# Multi-computer deploy: set the SERVER PC's LAN IP — every kiosk PC uses the same URL.
# Prefer editing config.json in this repo before npm run dist (see BUILD-KIOSK.md).
# See ../MULTI-COMPUTER.md

VITE_API_BASE_URL=http://192.168.1.6:8000
