# API base — see src/lib/api-base-url.ts
#
# `auto` = same hostname as the page, port VITE_API_PORT (default 8000).
#   Use with Vite `server.host: true`: phone opens http://192.168.x.x:5173
#   → API is http://192.168.x.x:8000 (backend must bind 0.0.0.0 and allow
#   that Vite origin in CORS).
#
# Override with a full URL if the API is elsewhere, e.g.:
#   VITE_API_BASE_URL=http://localhost:8000
# Copy to `.env.local` (gitignored) to keep machine-specific URLs out of git.
VITE_API_BASE_URL=auto
VITE_API_PORT=8000
