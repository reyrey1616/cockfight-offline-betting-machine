{
  "name": "cockfight-offline-betting-machine-client",
  "private": true,
  "version": "0.0.0",
  "description": "FMJ offline betting — web admin UI and Electron teller kiosk.",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:electron-print": "electron scripts/verify-electron-print.mjs",
    "dev:electron": "node scripts/run-dev.mjs",
    "electron": "electron .",
    "electron:prod": "node scripts/run-prod.mjs",
    "generate-icon": "node scripts/generate-icon.mjs",
    "prepare-kiosk-config": "node scripts/prepare-kiosk-config.mjs",
    "eject-dmg": "node scripts/eject-kiosk-dmg-volume.mjs",
    "pack": "npm run eject-dmg && npm run prepare-kiosk-config && npm run generate-icon && npm run build && electron-builder --dir",
    "dist": "npm run eject-dmg && npm run prepare-kiosk-config && npm run generate-icon && npm run build && electron-builder",
    "dist:mac": "npm run dist -- --mac",
    "dist:win": "npm run dist -- --win"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-query-devtools": "^5.100.10",
    "axios": "^1.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.0.11",
    "postcss": "^8.5.14",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.cockfight.offline.betting.kiosk",
    "productName": "FMJ offline betting machine",
    "icon": "build/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asarUnpack": [
      "electron/print-png-thermal.ps1"
    ],
    "files": [
      "electron/**/*",
      "shared/**/*",
      "config.example.json",
      "config.json"
    ],
    "extraFiles": [
      {
        "from": "config.example.json",
        "to": "config.example.json"
      }
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "client-dist",
        "filter": ["**/*"]
      },
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": ["dmg"],
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "FMJ offline betting machine"
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FMJ offline betting machine"
    }
  }
}
