# Copy to `.env.development`, `.env.production`, or `.env.local` (gitignored).
#
# Every VITE_-prefixed key is exposed in the client bundle — no secrets.
#
# API HTTP origin (axios + WebSocket host). Examples:
#   VITE_API_BASE_URL=http://localhost:8000
#   VITE_API_BASE_URL=http://192.168.1.10:8000
#   VITE_API_BASE_URL=auto          # same host as the browser, port below
VITE_API_BASE_URL=auto
VITE_API_PORT=8000
